# Copy this file to .env and fill in real values. Never commit .env.

# Contact form email (Resend) ------------------------------------------------
# 1. Sign up:        https://resend.com/signup
# 2. Create a key:   https://resend.com/api-keys  (permission: "Sending access")
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered. Until you verify your own domain
# in Resend, this MUST be the same email you signed up to Resend with.
CONTACT_TO_EMAIL=you@example.com

# Optional. Leave unset to use Resend's shared test sender. After verifying a
# domain (https://resend.com/domains) you can use e.g. "Krish <hello@yourdomain.com>".
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# GitHub showcase (/projects) ------------------------------------------------
# Optional. Raises the GitHub API limit from 60 to 5,000 requests/hour.
# Create a token with no scopes at https://github.com/settings/tokens?type=beta
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Blog (/blog) ----------------------------------------------------------------
# Real like counts (optional). Without these, the like button only remembers a
# visitor's own like in their browser and no public count is shown.
# Create a free Redis database at https://console.upstash.com, then copy the
# "REST URL" and "REST Token" from its dashboard.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Real comments via Giscus (optional; stored in GitHub Discussions).
# 1. Make a public repo and enable Discussions (Settings → General → Features).
# 2. Install the giscus app: https://github.com/apps/giscus
# 3. Fill the form at https://giscus.app (mapping: "pathname") and copy the values.
# Without these, posts show a "Join the discussion" card (LinkedIn + email).
# NEXT_PUBLIC_GISCUS_REPO=KriXsh/blog-comments
# NEXT_PUBLIC_GISCUS_REPO_ID=R_xxxxxxxxxx
# NEXT_PUBLIC_GISCUS_CATEGORY=Comments
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=DIC_xxxxxxxxxxxxxxxx
